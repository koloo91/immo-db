# Google Gemini API Key für KI-Dokumentenanalyse (PDF-Exposés, B-Pläne, Webseiten) & Q&A Chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# geobasis-cli Daemon URL (Standard: http://127.0.0.1:8080)
# Starte den Daemon mit: /Users/patrick/dev/projects/geobasis-cli/geobasis serve
GEOBASIS_URL=http://127.0.0.1:8080

# FlareSolverr URL zur Umgehung von Cloudflare bei Immobilienportalen (Standard: http://127.0.0.1:8191/v1)
# Starte FlareSolverr mit: docker run -d --name=flaresolverr -p 8191:8191 ghcr.io/flaresolverr/flaresolverr:latest
FLARESOLVERR_URL=http://127.0.0.1:8191/v1

# Eigene E-Mail-Adresse - hilft der KI beim Erkennen, ob eine Mail ein- oder ausgehend war
OWN_EMAIL=

# Suche & Job-Queue (per compose.yml gestartet: docker compose up -d)
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_KEY=immo-db-ai-local-dev-key
MEILI_MASTER_KEY=immo-db-ai-local-dev-key
REDIS_URL=redis://127.0.0.1:6380
